# Salin file ini menjadi server/.env sebelum menjalankan aplikasi.
# JANGAN commit file .env (berisi rahasia).

# Jalur database SQLite (relatif terhadap server/prisma/schema.prisma)
DATABASE_URL=file:./dev.db

# Ganti dengan string acak. Server akan gagal start bila kosong.
# Contoh membuat nilai acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Port server REST API
PORT=3001
